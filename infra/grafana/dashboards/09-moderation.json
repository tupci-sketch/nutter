{
  "uid": "habnut-moderation",
  "title": "Moderation",
  "tags": ["habnut", "moderation"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "60s",
  "panels": [
    {
      "id": 1,
      "title": "Active Bans",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "habnut_active_bans_total", "legendFormat": "Bans"}]
    },
    {
      "id": 2,
      "title": "Ban Spike (10m delta)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "delta(habnut_active_bans_total[10m])", "legendFormat": "Delta"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 20}, {"color": "red", "value": 50}]}}}
    },
    {
      "id": 3,
      "title": "Auth Failure Rate",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "rate(habnut_auth_failure_total[5m])", "legendFormat": "Failures/s"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 10}, {"color": "red", "value": 50}]}}}
    },
    {
      "id": 4,
      "title": "Auth Failures Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [{"expr": "rate(habnut_auth_failure_total[5m])", "legendFormat": "Failures/s"}]
    },
    {
      "id": 5,
      "title": "Audit Log Write Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "rate(habnut_audit_log_write_total[5m])", "legendFormat": "Writes/s"},
        {"expr": "rate(habnut_audit_log_write_errors_total[5m])", "legendFormat": "Errors/s"}
      ]
    },
    {
      "id": 6,
      "title": "Active Bans Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
      "targets": [{"expr": "habnut_active_bans_total", "legendFormat": "Active Bans"}]
    }
  ]
}
