# Habnut Emulator — generated by habnutctl install
# DO NOT edit by hand; use 'habnutctl configure' to regenerate.

server.host=0.0.0.0
server.port=8080
server.name={{.HotelName}}
server.version={{.EmulatorVersion}}

database.host={{.DbHost}}
database.port=3306
database.name=habnut
database.user=habnut
database.password={{.DbPass}}
database.pool.minimum=5
database.pool.maximum=20
database.pool.timeout=30000

redis.host={{.RedisHost}}
redis.port=6379
redis.password=
redis.database=0

metrics.enabled=true
metrics.port=8080
metrics.path=/metrics

logging.level=INFO
logging.format=JSON
logging.path=/var/log/habnut

game.tick.rate=10
game.pathfinding.enabled=true

wired.enabled=true
wired.max.global.variables=50000
wired.execution.timeout.ms=2000

economy.transaction.idempotency.enabled=true
economy.audit.log.enabled=true

rp.world.enabled={{.RpEnabled}}
garden.enabled=true
