{
  "uid": "habnut-room-memory",
  "title": "Room Memory",
  "tags": ["habnut", "rooms", "memory"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Total Room Memory",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "habnut_room_memory_bytes", "legendFormat": "Total"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 1e9}, {"color": "red", "value": 2e9}]}}}
    },
    {
      "id": 2,
      "title": "Active Rooms",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "habnut_rooms_active", "legendFormat": "Rooms"}]
    },
    {
      "id": 3,
      "title": "Memory Per Room (avg)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "habnut_room_memory_bytes / habnut_rooms_active", "legendFormat": "Bytes/Room"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 4,
      "title": "Room Memory Over Time",
      "type": "timeseries",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 4},
      "targets": [
        {"expr": "habnut_room_memory_bytes", "legendFormat": "Total Memory"},
        {"expr": "habnut_rooms_active", "legendFormat": "Active Rooms"}
      ]
    }
  ]
}
