{
  "uid": "habnut-economy",
  "title": "Economy",
  "tags": ["habnut", "economy"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Transaction Error Rate",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "rate(habnut_economy_transaction_errors_total[5m])", "legendFormat": "Errors/s"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 0.01}]}}}
    },
    {
      "id": 2,
      "title": "Idempotency Violations",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "rate(habnut_economy_duplicate_idempotency_total[5m])", "legendFormat": "Violations/s"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 0.001}]}}}
    },
    {
      "id": 3,
      "title": "RP Bank Transaction Errors",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "rate(habnut_rp_bank_transaction_errors_total[5m])", "legendFormat": "RP Errors/s"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 0.01}]}}}
    },
    {
      "id": 4,
      "title": "Economy Transactions Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
      "targets": [
        {"expr": "rate(habnut_economy_transaction_errors_total[5m])", "legendFormat": "Errors/s"},
        {"expr": "rate(habnut_economy_duplicate_idempotency_total[5m])", "legendFormat": "Idempotency Violations/s"}
      ]
    },
    {
      "id": 5,
      "title": "Audit Log Write Failures",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [{"expr": "rate(habnut_audit_log_write_errors_total[5m])", "legendFormat": "Audit Errors/s"}]
    },
    {
      "id": 6,
      "title": "Active Ban Spike",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"expr": "habnut_active_bans_total", "legendFormat": "Active Bans"},
        {"expr": "delta(habnut_active_bans_total[10m])", "legendFormat": "Delta 10m"}
      ]
    }
  ]
}
