{
  "uid": "habnut-nginx",
  "title": "Nginx",
  "tags": ["habnut", "nginx"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "5xx Error Rate",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "rate(nginx_http_requests_total{status=~\"5..\"}[5m])", "legendFormat": "5xx/s"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 2,
      "title": "Request Rate",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "rate(nginx_http_requests_total[5m])", "legendFormat": "Req/s"}]
    },
    {
      "id": 3,
      "title": "Active Connections",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "nginx_connections_active", "legendFormat": "Active"}]
    },
    {
      "id": 4,
      "title": "SSL Certificate Expiry",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "(probe_ssl_earliest_cert_expiry - time()) / 86400", "legendFormat": "Days"}],
      "fieldConfig": {"defaults": {"unit": "d", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 14}, {"color": "green", "value": 30}]}}}
    },
    {
      "id": 5,
      "title": "Request Rate by Status",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "rate(nginx_http_requests_total{status=~\"2..\"}[5m])", "legendFormat": "2xx"},
        {"expr": "rate(nginx_http_requests_total{status=~\"3..\"}[5m])", "legendFormat": "3xx"},
        {"expr": "rate(nginx_http_requests_total{status=~\"4..\"}[5m])", "legendFormat": "4xx"},
        {"expr": "rate(nginx_http_requests_total{status=~\"5..\"}[5m])", "legendFormat": "5xx"}
      ]
    },
    {
      "id": 6,
      "title": "Connection States",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "nginx_connections_active", "legendFormat": "Active"},
        {"expr": "nginx_connections_reading", "legendFormat": "Reading"},
        {"expr": "nginx_connections_writing", "legendFormat": "Writing"},
        {"expr": "nginx_connections_waiting", "legendFormat": "Waiting"}
      ]
    }
  ]
}
