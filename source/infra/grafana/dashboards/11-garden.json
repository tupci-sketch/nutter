{
  "uid": "habnut-garden",
  "title": "Community Garden",
  "tags": ["habnut", "garden"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "60s",
  "panels": [
    {
      "id": 1,
      "title": "Active Plots",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "habnut_garden_plots_active", "legendFormat": "Plots"}]
    },
    {
      "id": 2,
      "title": "Plants Growing",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "habnut_garden_plants_growing", "legendFormat": "Growing"}]
    },
    {
      "id": 3,
      "title": "Plants Withered",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "habnut_garden_plants_withered", "legendFormat": "Withered"}]
    },
    {
      "id": 4,
      "title": "Community Goal Progress",
      "type": "bargauge",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 4},
      "targets": [{"expr": "habnut_garden_community_goal_progress", "legendFormat": "Progress %"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "percent"}}
    },
    {
      "id": 5,
      "title": "Garden Activity Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 10},
      "targets": [
        {"expr": "habnut_garden_plots_active", "legendFormat": "Active Plots"},
        {"expr": "habnut_garden_plants_growing", "legendFormat": "Growing"},
        {"expr": "habnut_garden_plants_withered", "legendFormat": "Withered"},
        {"expr": "rate(habnut_garden_harvests_total[5m]) * 60", "legendFormat": "Harvests/min"}
      ]
    }
  ]
}
