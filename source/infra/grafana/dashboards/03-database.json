{
  "uid": "habnut-database",
  "title": "Database",
  "tags": ["habnut", "database", "mariadb"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Connection Usage",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "mysql_global_status_threads_connected / mysql_global_variables_max_connections * 100", "legendFormat": "Usage %"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "percent", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 60}, {"color": "red", "value": 80}]}}}
    },
    {
      "id": 2,
      "title": "Replication Lag",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "mysql_slave_status_seconds_behind_master", "legendFormat": "Lag (s)"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 10}, {"color": "red", "value": 30}]}}}
    },
    {
      "id": 3,
      "title": "Slow Query Rate",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "rate(mysql_global_status_slow_queries[5m])", "legendFormat": "Slow Queries/s"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 5}, {"color": "red", "value": 10}]}}}
    },
    {
      "id": 4,
      "title": "Active Connections Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [
        {"expr": "mysql_global_status_threads_connected", "legendFormat": "Connected"},
        {"expr": "mysql_global_status_threads_running", "legendFormat": "Running"}
      ]
    },
    {
      "id": 5,
      "title": "Query Throughput",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {"expr": "rate(mysql_global_status_questions[5m])", "legendFormat": "Queries/s"},
        {"expr": "rate(mysql_global_status_slow_queries[5m])", "legendFormat": "Slow/s"}
      ]
    },
    {
      "id": 6,
      "title": "InnoDB Buffer Pool",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "targets": [
        {"expr": "mysql_global_status_innodb_buffer_pool_pages_data / mysql_global_status_innodb_buffer_pool_pages_total * 100", "legendFormat": "Used %"},
        {"expr": "mysql_global_status_innodb_buffer_pool_read_requests", "legendFormat": "Read Requests"}
      ]
    }
  ]
}
