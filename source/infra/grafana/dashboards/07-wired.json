{
  "uid": "habnut-wired",
  "title": "Wired Engine",
  "tags": ["habnut", "wired"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Execution Timeout Rate",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "rate(habnut_wired_execution_timeout_total[5m])", "legendFormat": "Timeouts/s"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.01}, {"color": "red", "value": 0.05}]}}}
    },
    {
      "id": 2,
      "title": "Global Variable Count",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "habnut_wired_global_variables_total", "legendFormat": "Global Vars"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 5000}, {"color": "red", "value": 10000}]}}}
    },
    {
      "id": 3,
      "title": "Wired Execution Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "rate(habnut_wired_executions_total[5m])", "legendFormat": "Executions/s"},
        {"expr": "rate(habnut_wired_execution_timeout_total[5m])", "legendFormat": "Timeouts/s"}
      ]
    },
    {
      "id": 4,
      "title": "Global Variables Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{"expr": "habnut_wired_global_variables_total", "legendFormat": "Global Variables"}]
    }
  ]
}
