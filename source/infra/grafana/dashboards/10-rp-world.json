{
  "uid": "habnut-rp",
  "title": "Nutropolis RP World",
  "tags": ["habnut", "rp", "nutropolis"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "60s",
  "panels": [
    {
      "id": 1,
      "title": "Active RP Characters",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "habnut_rp_characters_active", "legendFormat": "Characters"}]
    },
    {
      "id": 2,
      "title": "RP Bank Transaction Errors",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "rate(habnut_rp_bank_transaction_errors_total[5m])", "legendFormat": "Errors/s"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "red", "value": 0.01}]}}}
    },
    {
      "id": 3,
      "title": "Active Dispatch Calls",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "habnut_rp_dispatch_calls_active", "legendFormat": "Calls"}]
    },
    {
      "id": 4,
      "title": "Players in Prison",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "habnut_rp_players_in_prison", "legendFormat": "In Prison"}]
    },
    {
      "id": 5,
      "title": "RP Bank Transactions Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "rate(habnut_rp_bank_transaction_total[5m])", "legendFormat": "Transactions/s"},
        {"expr": "rate(habnut_rp_bank_transaction_errors_total[5m])", "legendFormat": "Errors/s"}
      ]
    },
    {
      "id": 6,
      "title": "RP Characters Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{"expr": "habnut_rp_characters_active", "legendFormat": "Active Characters"}]
    }
  ]
}
