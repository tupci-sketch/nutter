# Habnut — the web server, behind Cloudflare.
#
# A template: the nginx image fills in ${HABNUT_DOMAIN} as it starts and leaves
# nginx's own variables alone, because it only replaces variables that are set
# in its environment.
#
# The same layout as the local edition, which is the one shown to work: the
# website at /, the game at /client/, the hotel's socket at /ws, the artwork at
# /assets/, and avatar pictures at /imager/. One origin throughout, so the
# website's sign-in, the ticket, the socket and the pictures need nothing
# opened up between them.

# Docker's own resolver, so a service that restarts with a new address is
# found again instead of nginx holding on to the old one until it restarts.
resolver 127.0.0.11 valid=10s ipv6=off;

# Visitors arrive through Cloudflare's tunnel, whose connector runs on this
# machine, so every connection comes from here; the visitor's own address is
# in CF-Connecting-IP. Nothing outside this machine can reach this server at
# all — its port is bound to 127.0.0.1 — so the header is trusted from local
# addresses and nowhere else.
set_real_ip_from 127.0.0.1;
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header CF-Connecting-IP;

# Cloudflare says whether the visitor used https. PHP needs to know, or the
# website builds http links and cannot mark its cookies secure.
map $http_x_forwarded_proto $habnut_https {
    default "";
    https   on;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# www goes to the bare domain, so sign-in cookies and the session live on one
# host. Cloudflare already terminated https, so the redirect can name it.
server {
    listen 80;
    server_name www.${HABNUT_DOMAIN};
    server_tokens off;
    return 301 https://${HABNUT_DOMAIN}$request_uri;
}

server {
    listen 80 default_server;
    server_name ${HABNUT_DOMAIN};
    server_tokens off;

    root /var/www/cms/public;
    index index.php;
    client_max_body_size 20M;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The hotel. Only the socket is reachable from outside; its health and
    # metrics ports stay on the containers' own network.
    location /ws {
        set $hotel http://emulator:3000;
        proxy_pass $hotel;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Avatar and badge pictures. Everything that changes a picture is in its
    # URL, so Cloudflare can keep them for a day.
    location /imager/ {
        set $imager imager:8081;
        rewrite ^/imager/(.*)$ /$1 break;
        proxy_pass http://$imager;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=86400" always;
    }

    # The game: a single page. Its own index, because the server's is
    # index.php and a bare /client/ — where the website sends a signed-in
    # player — would otherwise be a forbidden directory listing.
    location /client/ {
        alias /var/www/client/;
        index index.html;
        try_files $uri $uri/ /client/index.html;
    }

    # Content-hashed bundles: safe to keep forever.
    location /client/assets/ {
        alias /var/www/client/assets/;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
    }

    # The installed asset pack, as the game asks for it: /assets/<era>/...
    # A week at the edge; purge Cloudflare's cache after installing a pack.
    location /assets/ {
        alias /var/www/assets/;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=604800" always;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        set $website cms:9000;
        fastcgi_pass $website;
        fastcgi_index index.php;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param HTTPS $habnut_https if_not_empty;
        fastcgi_read_timeout 60s;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}
