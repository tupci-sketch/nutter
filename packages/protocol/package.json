{
  "name": "@habnut/protocol",
  "version": "0.0.1",
  "private": true,
  "description": "Shared WebSocket packet definitions for all Habnut domains",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "zod": "^3.22.4"
  }
}
