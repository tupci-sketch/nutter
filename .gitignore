# Dependencies
node_modules/
vendor/

# Build outputs
dist/
build/
*.jar
# The Gradle wrapper jar must be committed: CI and a fresh clone both run
# ./gradlew, which cannot bootstrap without it.
!gradle/wrapper/gradle-wrapper.jar
*.war
*.class
target/

# Gradle
.gradle/
apps/emulator/.gradle/
apps/emulator/build/

# Go
apps/launcher/habnutctl
apps/launcher/habnutctl.exe

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# IDE
.idea/
.vscode/
*.iml
*.iws

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test coverage
coverage/
.nyc_output/

# Turbo cache
.turbo/

# SWF asset packs (never committed — operator-supplied)
infra/swf/source/
infra/swf/rebranded/
infra/swf/previous/
/var/lib/habnut/

# Playwright
test-results/
playwright-report/

# PHPUnit
apps/cms/.phpunit.result.cache

# Laravel runtime directories. The trees themselves must exist on a fresh
# clone — Laravel refuses to boot without them — so the directory skeleton is
# tracked through each .gitignore while their contents stay ignored.
apps/cms/bootstrap/cache/*.php
apps/cms/storage/*
!apps/cms/storage/app/
apps/cms/storage/app/*
!apps/cms/storage/app/public/
!apps/cms/storage/framework/
apps/cms/storage/framework/*
!apps/cms/storage/framework/cache/
apps/cms/storage/framework/cache/*
!apps/cms/storage/framework/cache/data/
!apps/cms/storage/framework/sessions/
!apps/cms/storage/framework/views/
!apps/cms/storage/logs/
!.gitignore

# Misc
*.tmp
*.bak
*.swp

# Launcher release artifacts (generated by scripts/build-launcher.sh)
/dist/
/apps/launcher/internal/payload/data/
