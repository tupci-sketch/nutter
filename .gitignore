# Dependencies
node_modules/
vendor/

# Build outputs. bin/ is deliberately not here: the released executables are
# committed, so somebody can download a hotel without building one first.
dist/
build/
*.jar
# The Gradle wrapper jar must be committed: CI and a fresh clone both run
# ./gradlew, which cannot bootstrap without it.
!source/gradle/wrapper/gradle-wrapper.jar
*.war
*.class
target/

# Gradle
.gradle/
source/apps/emulator/.gradle/
source/apps/emulator/build/

# Go
source/apps/launcher/habnutctl
source/apps/launcher/habnutctl.exe

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# IDE
.idea/
.vscode/
*.iml
*.iws

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test coverage
coverage/
.nyc_output/

# Turbo cache
.turbo/

# SWF asset packs (never committed — operator-supplied)
source/infra/swf/source/
source/infra/swf/rebranded/
source/infra/swf/previous/
/var/lib/habnut/

# Playwright
test-results/
playwright-report/

# PHPUnit
source/apps/cms/.phpunit.result.cache

# Laravel runtime directories. The trees themselves must exist on a fresh
# clone — Laravel refuses to boot without them — so the directory skeleton is
# tracked through each .gitignore while their contents stay ignored.
source/apps/cms/bootstrap/cache/*.php
source/apps/cms/storage/*
!source/apps/cms/storage/app/
source/apps/cms/storage/app/*
!source/apps/cms/storage/app/public/
!source/apps/cms/storage/framework/
source/apps/cms/storage/framework/*
!source/apps/cms/storage/framework/cache/
source/apps/cms/storage/framework/cache/*
!source/apps/cms/storage/framework/cache/data/
!source/apps/cms/storage/framework/sessions/
!source/apps/cms/storage/framework/views/
!source/apps/cms/storage/logs/
!.gitignore

# Misc
*.tmp
*.bak
*.swp

# Launcher release artifacts (generated by scripts/build-launcher.sh).
#
# The three archives here are the emulator, the client and the CMS on their way
# into the executable. The path used to be rooted before the move into source/,
# so the rule stopped matching and two of the three were committed — 33MB of
# build output churning on every build, while the third stayed ignored by the
# blanket *.jar rule. The executables in bin/ are the thing worth committing;
# these are what they are made from.
/dist/
source/apps/launcher/internal/payload/data/
